# Documentation only. docker compose works without a .env file.
# To override, copy this to .env (which git ignores) and change values.

# Seconds a seat stays HELD before it expires. Use 2 to test expiry quickly.
HOLD_DURATION_SECONDS=600

# PostgreSQL container
POSTGRES_DB=school_admission
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional: point the API at another database. The first one set wins.
# DATABASE_CONNECTION_STRING=Host=db;Port=5432;Database=school_admission;Username=postgres;Password=postgres
# DATABASE_URL=postgres://postgres:postgres@db:5432/school_admission

# Frontend API URL (built into the static files; rebuild after changing)
VITE_API_BASE_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080
