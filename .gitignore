# Allowlist: only deliverables and app code are tracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/ASSUMPTIONS.md
!/AI_USAGE.md
!/automatedTestAndResults.md
!/docker-compose.yml
!/.github/
!/e2e/
!/backend/
!/frontend/
# Design diagrams only; the rest of planning/ stays local.
!/planning/
/planning/*
!/planning/diagrams/
/planning/diagrams/*
!/planning/diagrams/*.png
!/planning/UI-UX-decisions.md

# Explicitly local, even if the allowlist above changes.
CLAUDE.md
SKILL.md
requirement.md
decision.md
.claude/

# .NET
bin/
obj/
.vs/
*.user

# Node
node_modules/
dist/
*.tsbuildinfo

# Env
.env
.env.*
!/.env.example

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
